<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/music_widget_background">

    <!-- 1. Cabecera (Oculta v1.8.6) -->
    <ImageView
        android:layout_width="60dp"
        android:layout_height="8dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:src="@drawable/preview_skeleton_pill"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <!-- 2. Bloque Now Playing (Conjunto Previews-Wide-1: refleja Layout4x4: portada de 110dp fija,
                columna de texto a 12dp de la portada y fila de controles anclada abajo) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Píldora de arte: cápsula inclinada -28° (misma forma que la portada real) -->
            <FrameLayout
                android:id="@+id/loading_art_container_large"
                android:layout_width="110dp"
                android:layout_height="110dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/preview_skeleton_art"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- Columna de texto + controles -->
            <RelativeLayout
                android:id="@+id/skeleton_text_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp">

                <!-- Título y artista (Ecuador Visual: título sobre el ecuador, artista bajo él) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="18dp"
                        android:src="@drawable/preview_skeleton_bar"
                        android:contentDescription="@null" />
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="13dp"
                        android:src="@drawable/preview_skeleton_bar"
                        android:alpha="0.6"
                        android:contentDescription="@null" />
                </LinearLayout>

                <!-- Fila de controles: barra de progreso + grupo prev/next -->
                <LinearLayout
                    android:id="@+id/skeleton_controls_row"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:src="@drawable/preview_skeleton_bar"
                        android:contentDescription="@null" />
                    <ImageView
                        android:id="@+id/skeleton_controls_group"
                        android:layout_width="74dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/preview_skeleton_pill"
                        android:contentDescription="@null" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- 3. SECCIÓN HISTORIAL (Sincronía v1.8.4; encabezado + filas de la altura real) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Encabezado "Recientes": 28dp (ícono 20dp + 8dp de padding inferior) -->
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="13dp"
                    android:src="@drawable/preview_skeleton_bar"
                    android:contentDescription="@null" />
                <!-- Esqueleto Fila 1 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="3dp"
                    android:src="@drawable/bg_preview_card"
                    android:contentDescription="@null" />
                <!-- Esqueleto Fila 2 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="3dp"
                    android:src="@drawable/bg_preview_card"
                    android:contentDescription="@null" />
                <!-- Esqueleto Fila 3 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="3dp"
                    android:src="@drawable/bg_preview_card"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- EL SCRIM DE DESVANECIMIENTO (v1.8.6) -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:src="@drawable/history_fade_scrim"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>

    <!-- 4. Botón play/pausa flotante (esquina inferior derecha, 64x48dp, como PlayPauseButton) -->
    <ImageView
        android:id="@+id/skeleton_play_button"
        android:layout_width="64dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="@dimen/widget_padding"
        android:layout_marginEnd="@dimen/widget_padding"
        android:src="@drawable/preview_skeleton_pill"
        android:contentDescription="@null" />
</RelativeLayout>
