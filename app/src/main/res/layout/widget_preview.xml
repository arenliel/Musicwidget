<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="17dp"
    android:theme="@style/Theme.MusicWidget"
    android:background="@drawable/preview_background">

    <!-- 1. Portada (Píldora + Nota Central Condicional) -->
    <FrameLayout
        android:id="@+id/preview_art_container"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">

        <ImageView
            android:id="@+id/preview_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_preview_pill"
            android:contentDescription="art" />

        <!-- Esta nota solo será visible cuando NO haya portada real -->
        <ImageView
            android:id="@+id/preview_placeholder_note"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_music_note"
            android:tint="@color/music_widget_accent"
            android:contentDescription="no_art" />
    </FrameLayout>

    <!-- 2. Visualizador (Reloj) -->
    <!-- Añadimos fondo circular para paridad con el widget real -->
    <ImageView
        android:id="@+id/preview_visualizer"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignBottom="@id/preview_art_container"
        android:layout_alignEnd="@id/preview_art_container"
        android:layout_marginBottom="-8dp"
        android:layout_marginEnd="6dp"
        android:padding="2dp"
        android:background="@drawable/preview_visualizer_bg"
        android:src="@drawable/ic_music_history"
        android:contentDescription="v" />

    <!-- 3. Textos -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/preview_app_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_music_note"
                android:tint="@color/music_widget_accent"
                android:contentDescription="icon" />

            <TextView
                android:id="@+id/preview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Song Title"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/music_widget_text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/preview_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Artist Name"
            android:textSize="14sp"
            android:textColor="@color/music_widget_text_secondary" />
    </LinearLayout>

</RelativeLayout>