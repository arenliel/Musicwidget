<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="17dp"
    android:theme="@style/Theme.MusicWidget"
    android:background="@drawable/preview_background">

    <!-- 1. Estado (Esquina Superior Derecha) -->
    <TextView
        android:id="@+id/preview_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:text="Recientemente"
        android:textSize="13sp"
        android:visibility="gone"
        android:textColor="@color/music_widget_text_secondary" />

    <!-- 2. Cuerpo Central (Horizontal: Píldora + Textos Anclados) -->
    <LinearLayout
        android:id="@+id/preview_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Portada Píldora -->
        <FrameLayout
            android:id="@+id/preview_art_container"
            android:layout_width="110dp"
            android:layout_height="110dp">

            <ImageView
                android:id="@+id/preview_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_preview_pill"
                android:contentDescription="art" />

            <ImageView
                android:id="@+id/preview_placeholder_note"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_note"
                android:tint="@color/music_widget_accent"
                android:contentDescription="no_art" />

            <ImageView
                android:id="@+id/preview_visualizer"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="3dp"
                android:layout_marginEnd="6dp"
                android:padding="2dp"
                android:background="@drawable/preview_visualizer_bg"
                android:src="@drawable/ic_music_history"
                android:contentDescription="v" />
        </FrameLayout>

        <!-- Textos: Centrados verticalmente respecto al arte -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/preview_app_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/music_widget_accent"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_empty_title"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/music_widget_text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/preview_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_empty_subtitle"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/music_widget_text_secondary" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>